# Database
DATABASE_URL="postgresql://botuser:botpassword@localhost:5432/bot_tg_db"

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Código usa TELEGRAM_TOKEN (alinear con despliegue)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Admin (Telegram chat id numérico)
ADMIN_ID=

# MCP notify endpoint — clave compartida con mcp-finance
NOTIFY_API_KEY=

# Finanzas: modo pruebas Google (whitelist de correos en el tutorial)
GOOGLE_TESTING_MODE=false

# Cron monitor de integraciones (delay entre usuarios ms; 0 = sin límite de usuarios por ciclo)
CRON_DELAY_MS=500
CRON_MAX_USERS_PER_CYCLE=0
NOTIFY_COOLDOWN_DAYS=3
ONBOARDING_STALE_DAYS=3


# DNS API (Cloudflare DNS Manager — consume la API en dns-api.homelab.local)
DNS_API_BASE_URL=https://dns-api.homelab.local
CF_DNS_API_TOKEN=your_dns_api_token_here
DNS_ZONE=toothless.codes
