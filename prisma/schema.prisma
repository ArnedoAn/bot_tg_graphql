// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tarjeta {
  id        String @id
  cardId    String @unique
  apiCardId String @unique
}

model Vehicle {
  id        Int    @id @default(autoincrement())
  name      String @unique
  lastDigit Int
  userId    String 
}

model Reminder {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  userId      String
}

/// Preferencias por usuario de Telegram (chatId como string)
model UserSettings {
  userId   String @id @map("user_id")
  /// "simple" | "advanced"
  menuMode String @default("simple") @map("menu_mode")

  @@map("user_settings")
}

/// Progreso del onboarding guiado de Finance (chatId = userId)
model FinanceOnboardingProgress {
  userId           String    @id @map("user_id")
  currentStep      String    @default("start") @map("current_step")
  gmailDone        Boolean   @default(false) @map("gmail_done")
  fireflyTokenDone Boolean   @default(false) @map("firefly_token_done")
  webUiDone        Boolean   @default(false) @map("web_ui_done")
  apkManualDone    Boolean   @default(false) @map("apk_manual_done")
  completedAt      DateTime? @map("completed_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("finance_onboarding_progress")
}

/// Archivos del bot referenciados por Telegram file_id (ej. APK)
model BotAsset {
  id           String   @id
  fileId       String   @map("file_id")
  fileUniqueId String?  @map("file_unique_id")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("bot_assets")
}

/// Feature flags globales (key -> enabled)
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

/// Usuario del bot (chatId de Telegram); se registra en /start
model User {
  id        String   @id @map("user_id")
  username  String?
  firstName String?  @map("first_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Solicitud de correo Google en modo pruebas (whitelist en Google Cloud Console)
model GoogleWhitelist {
  userId    String   @id @map("user_id")
  email     String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("google_whitelist")
}

/// Caché de estado de integraciones y control de notificaciones del cron
model UserIntegrationStatus {
  userId               String    @id @map("user_id")
  gmailConnected       Boolean   @default(false) @map("gmail_connected")
  fireflyConnected     Boolean   @default(false) @map("firefly_connected")
  gmailEverConnected   Boolean   @default(false) @map("gmail_ever_connected")
  fireflyEverConnected Boolean   @default(false) @map("firefly_ever_connected")
  lastCheckedAt        DateTime? @map("last_checked_at")
  lastNotifiedAt       DateTime? @map("last_notified_at")
  lastOnboardingReminderAt DateTime? @map("last_onboarding_reminder_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("user_integration_status")
}
